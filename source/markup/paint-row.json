{"html":"<div class=\"paint-row\"><div class=\"paint-field\"><button class=\"swatch\" title=\"Edit paint\" aria-label=\"Edit paint\"><i style=\"background: rgb(255, 255, 255);\"></i></button><input class=\"hex\" aria-label=\"Hex color\" value=\"FFFFFF\"><div style=\"width: 52px;\"><label class=\"field no-label pct-inline\"><input placeholder=\"\" value=\"100\"><span class=\"suffix\">%</span></label></div></div><button class=\"icon-btn\" title=\"Hide\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5.5 12c1.5-2.75 3.9-4.5 6.5-4.5s5 1.75 6.5 4.5c-1.5 2.75-3.9 4.5-6.5 4.5s-5-1.75-6.5-4.5z\"></path><circle cx=\"12\" cy=\"12\" r=\"2\"></circle></svg></button><button class=\"icon-btn\" title=\"Remove\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6.5 12h11\"></path></svg></button></div>","w":240,"h":32,"count":1}