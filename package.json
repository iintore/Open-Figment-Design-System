{
  "name": "open-figment-design-system",
  "private": true,
  "version": "1.1.0",
  "description": "Open Figment design system: foundations, components and blocks of an open-source collaborative design tool",
  "author": "Tony Lewis MANZI",
  "license": "MIT",
  "homepage": "https://github.com/iintore/Open-Figment-Design-System#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iintore/Open-Figment-Design-System.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && vite build",
    "capture": "node scripts/capture.mjs",
    "content": "python3 scripts/build_content.py",
    "packages:build": "node scripts/packages/build.mjs",
    "packages:test": "vitest run --config packages/vitest.config.mjs",
    "packages:check": "node scripts/packages/check.mjs",
    "packages:version": "node scripts/packages/version.mjs",
    "release": "npm run packages:build && npm run packages:test && npm run packages:check && npm publish --workspaces --access public"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "publint": "^0.3.25",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
