{
  "name": "@open-figment/icons",
  "version": "1.1.0",
  "description": "The Open Figment icon set: 91 outline icons as React components and SVG files.",
  "keywords": [
    "open-figment",
    "design-system",
    "icons",
    "react",
    "svg"
  ],
  "homepage": "https://open-figment-design-system.vercel.app",
  "bugs": {
    "url": "https://github.com/iintore/Open-Figment-Design-System/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iintore/Open-Figment-Design-System.git",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "author": "Tony Lewis MANZI",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
